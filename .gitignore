# =========================================================================
# 🔒 PROJECT CRYPTOGRAPHY & SECURITY KEYS (CRITICAL)
# =========================================================================
# Never allow your private Aiven cluster binary truststores into source control
*.jks
*.pem
*.crt
*.key
*.p12
*.properties.local
application-local-secrets.properties

# =========================================================================
# 🍃 SPRING BOOT RUNTIME ENVIRONMENTAL CACHES
# =========================================================================
# Excludes local run caches and background process metadata logs
.env
.env.local
*.log
/logs/
build/
bin/
out/

# =========================================================================
# 🐘 GRADLE BUILD ENGINE DIRECTORIES
# =========================================================================
# Hides local build artifacts and fileChange lock binaries (.gradle/last-build.bin)
.gradle/
/.gradle/*
/build/
!gradle/wrapper/gradle-wrapper.jar

# =========================================================================
# 💻 INTELIJ IDEA & ECLIPSE SYSTEM ARTIFACTS
# =========================================================================
# Hides local workspace personalization setups
.idea/
*.iws
*.iml
*.ipr
.classpath
.project
.settings/
.factorypath